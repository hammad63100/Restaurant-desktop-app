{
  "name": "gul-khan-fast-food",
  "version": "0.1.0",
  "private": true,
  "description": "Offline fast food management desktop app for Gul Khan Fast Food",
  "author": "Gul Khan Fast Food",
  "license": "UNLICENSED",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:auth": "node scripts/auth-smoke-test.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,bcrypt",
    "preview": "node scripts/preview-server.mjs",
    "test:all": "npm run build:electron && node scripts/test-all.mjs",
    "test": "npm run test:all",
    "verify": "npm run typecheck && npm run lint && npm run test:all"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "bcrypt": "6.0.0",
    "better-sqlite3": "13.2.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "9.39.5",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.2",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8"
  }
}
